   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "sr = 22050\n",
    "t = np.arange(0, 0.02, 1/sr)\n",
    "y = np.sin(2 * np.pi * 440 * t)\n",
    "\n",
    "plt.plot(t,y)\n",
    "plt.xlabel(\"Time (s)\")\n",
    "plt.ylabel(\"Amplitude\")\n",
    "plt.show()"
   ]
  },
